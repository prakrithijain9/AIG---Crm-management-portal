# Copy to backend/.env and fill in real values. Never commit backend/.env.
# development / test: relaxed local defaults. Any other value is treated as production.
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=aig_crm
DB_PASSWORD=change-me
DB_NAME=aig_crm_dev

# Optional: PostgreSQL TLS (libpq sslmode: disable, allow, prefer, require, verify-ca, verify-full).
# Unset: libpq's default locally (works with a local server without SSL); verify-full in
# production, which also refuses any weaker value.
# DB_SSLMODE=
# Optional: CA certificates for verify-ca/verify-full: a file path, or "system" for the OS store.
# Unset: the certifi bundle, which already includes Neon's CA (Let's Encrypt ISRG Root X1).
# DB_SSLROOTCERT=

CORS_ORIGINS=http://localhost:3000

# Optional: database used only by pytest (defaults to aig_crm_test)
TEST_DB_NAME=aig_crm_test

# --- Authentication ------------------------------------------------------------------
# Secret used to sign session tokens. Leave empty here; put a unique random value
# (at least 32 characters) in backend/.env only. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(64))"
# Needed for sign-in in every environment: without it, development still starts but the
# login page reports "Sign-in is not configured" and every CRM request is refused.
# Outside development/test the API refuses to start without it.
# Changing it signs everyone out.
JWT_SECRET_KEY=

# Optional: token claims and lifetime (minutes, 5-1440; default 480 = 8 hours)
# JWT_ISSUER=aig-crm-api
# JWT_AUDIENCE=aig-crm-web
# JWT_EXPIRE_MINUTES=480

# Optional: send the session cookie over HTTPS only.
# Default: false in development/test (plain http://localhost), true otherwise.
# Cannot be set to false outside development/test.
# COOKIE_SECURE=

# Optional: comma-separated origins allowed to send state-changing requests
# (scheme://host[:port], no path). Defaults to CORS_ORIGINS.
# TRUSTED_ORIGINS=http://localhost:3000

# --- Chat assistant ------------------------------------------------------------------
# Groq API key (free tier works). Put the real value in backend/.env only, never here.
# Unset: the assistant answers "not configured" and the rest of the CRM works as normal.
GROQ_API_KEY=

# Optional second provider (Gemini). Real value in backend/.env only.
GEMINI_API_KEY=

# Optional (defaults shown). Groq's free tier allows 200k tokens/day per model, so when CHAT_MODEL is
# rate limited or down the assistant retries the question on the next model in the chain. Entries are
# provider:model (groq | gemini); a provider without a key is skipped.
# CHAT_MODEL=openai/gpt-oss-120b
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_FALLBACK_MODELS=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# IANA time zone used to resolve "today", "overdue", "this month".
# CHAT_TIMEZONE=Asia/Kolkata
# CHAT_MAX_TOOL_ROUNDS=5
# CHAT_RATE_LIMIT_PER_MIN=10
