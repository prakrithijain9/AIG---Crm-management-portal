# Copy to backend/.env and fill in real values. Never commit backend/.env.
# development / test: relaxed local defaults. Any other value is treated as production.
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=aig_crm
DB_PASSWORD=change-me
DB_NAME=aig_crm_dev

CORS_ORIGINS=http://localhost:3000

# Optional: database used only by pytest (defaults to aig_crm_test)
TEST_DB_NAME=aig_crm_test

# --- Authentication ------------------------------------------------------------------
# Secret used to sign session tokens. Leave empty here; put a unique random value
# (at least 32 characters) in backend/.env only. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(64))"
# Needed for sign-in in every environment: without it, development still starts but the
# login page reports "Sign-in is not configured" and every CRM request is refused.
# Outside development/test the API refuses to start without it.
# Changing it signs everyone out.
JWT_SECRET_KEY=

# Optional: token claims and lifetime (minutes, 5-1440; default 480 = 8 hours)
# JWT_ISSUER=aig-crm-api
# JWT_AUDIENCE=aig-crm-web
# JWT_EXPIRE_MINUTES=480

# Optional: send the session cookie over HTTPS only.
# Default: false in development/test (plain http://localhost), true otherwise.
# Cannot be set to false outside development/test.
# COOKIE_SECURE=

# Optional: comma-separated origins allowed to send state-changing requests
# (scheme://host[:port], no path). Defaults to CORS_ORIGINS.
# TRUSTED_ORIGINS=http://localhost:3000
